{
    "files.eol": "\n",
    "css.lint.unknownAtRules": "ignore",
    "explorer.compactFolders": false,
    "diffEditor.ignoreTrimWhitespace": false,
    "diffEditor.renderSideBySide": false,
    "editor.copyWithSyntaxHighlighting": false,
    "editor.emptySelectionClipboard": false,
    "editor.multiCursorModifier": "ctrlCmd",
    "terminal.integrated.defaultProfile.linux": "zsh",
    "editor.snippetSuggestions": "top",
    "editor.detectIndentation": false,
     "editor.wordWrap": "off",
    "files.insertFinalNewline": true,
    "window.newWindowDimensions": "inherit",
    "window.nativeFullScreen": false,
    "workbench.sideBar.location": "right",
    "workbench.statusBar.visible": true,
    "workbench.editor.showTabs": "multiple",
    "workbench.tree.indent": 20,
    "workbench.tree.renderIndentGuides": "always",
    "editor.minimap.enabled": false,
    "editor.lineNumbers": "on",
    // "editor.colorDecorators": false,
    "editor.gotoLocation.multipleDefinitions": "goto",
    "editor.gotoLocation.multipleDeclarations": "goto",
    "editor.gotoLocation.multipleImplementations": "goto",
    "editor.gotoLocation.multipleReferences": "goto",
    "editor.gotoLocation.multipleTypeDefinitions": "goto",
    "editor.hideCursorInOverviewRuler": true,
    "editor.hover.enabled": false,
    "editor.lightbulb.enabled": "off",
    "editor.matchBrackets": "never",
    "editor.occurrencesHighlight": "off",
    "editor.overviewRulerBorder": false,
    "editor.renderLineHighlight": "none",
    "editor.selectionHighlight": false,
    "problems.decorations.enabled": true,
    "workbench.editor.enablePreviewFromQuickOpen": false,
    "workbench.tips.enabled": false,
    "workbench.startupEditor": "none",
    "editor.fontSize": 16,
    "editor.lineHeight": 45,
    "editor.suggestFontSize": 15,
    "editor.suggestLineHeight": 28,
    "terminal.integrated.fontSize": 14,
    "terminal.integrated.lineHeight": 1,
    "search.useIgnoreFiles": false,
    "search.exclude": {
        "**/node_modules": true,
        "**/vite": true,
        "**/out": true,
        "**/workspace": true,
        "**/package-lock.json": true,
        "**/yarn.lock": true,
        // java stuff
        "**/target": true,
        "**/build": true,
        "**/.idea": true,
    },
    "files.exclude": {
        "**/.idea": true,
    },
    "files.autoSave": "onWindowChange",
    "editor.wordSeparators": "`~!@#%^&*()=+[{]}\\|;:'\",.<>/?",
    "prettier.requireConfig": true,
    "prettier.useEditorConfig": false,
    "window.titleBarStyle": "native",
    "editor.guides.indentation": false,
    "explorer.confirmDelete": false,
    "editor.trimAutoWhitespace": false,
    "git.openRepositoryInParentFolders": "never",
    "eslint.timeBudget.onFixes": {
        "warn": 3000,
        "error": 6000
    },
    "playwright.reuseBrowser": true,
    "playwright.showTrace": false,
    "prettier.printWidth": 120,
    "terminal.integrated.defaultProfile.osx": "zsh",
    "editor.stickyScroll.scrollWithEditor": false,
    "workbench.tree.enableStickyScroll": false,
    "editor.hover.sticky": false,
    "editor.stickyScroll.enabled": false,
    "explorer.confirmPasteNative": false,
    "editor.renderWhitespace": "all",
    "editor.tabSize": 4,
    "editor.renderControlCharacters": false,
    "terminal.integrated.stickyScroll.enabled": false,
    "js/ts.updateImportsOnFileMove.enabled": "always",
    "editor.codeActionsOnSave": {
        "source.removeUnusedImports": "explicit"
    },
    "eslint.codeActionsOnSave.options": {
        "fixAll": true,
    },
    "terminal.integrated.defaultProfile.windows": "Git Bash",
    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "gitlens.ai.model": "vscode",
    "gitlens.ai.vscode.model": "copilot:gpt-4.1",
    "workbench.colorCustomizations": {
        "gitDecoration.modifiedResourceForeground": "#ffa500",
        "gitDecoration.untrackedResourceForeground": "#00ff00",
        "gitDecoration.addedResourceForeground": "#00ff00",
        "gitDecoration.deletedResourceForeground": "#ff0000"
    },
    "update.showReleaseNotes": false,
    "explorer.confirmDragAndDrop": false,
    "terminal.integrated.suggest.enabled": false,
    "workbench.editor.empty.hint": "hidden",
    "[typescript]": {
        "editor.defaultFormatter": "vscode.typescript-language-features"
    },
    "[markdown]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.wordWrap": "off",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.fixAll.markdownlint": "always"
        },
    },
    "git.blame.editorDecoration.enabled": false,
    // Git decorations
	"scm.defaultViewMode": "tree",
	"git.decorations.enabled": true,
	"git.enableSmartCommit": true,
	"gitlens.hovers.currentLine.over": "line",
	"scm.diffDecorations": "gutter",
    "gitlens.codeLens.enabled": false,
    "workbench.editor.enablePreview": false,
    "window.autoDetectColorScheme": false,
    "[json]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "yaml.disableSchemaDetection": [
        "**/.github/workflows/*.yml",
        "**/.github/workflows/*.yaml",
        "**/.gitea/workflows/*.yml",
        "**/.gitea/workflows/*.yaml",
        "**/.forgejo/workflows/*.yml",
        "**/.forgejo/workflows/*.yaml"
    ],
}
